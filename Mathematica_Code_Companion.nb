               StyleBox["m", "TI"], "2"], ",", 
              SubscriptBox[
               StyleBox["m", "TI"], "3"]}], "]"}], "\[LongEqual]"}]}]], 
          "InlineFormula",ExpressionUUID->
          "7470c261-22c9-4c3e-a672-afaea2ca357a"],
         " "
        }],ExpressionUUID->"f497f80c-9e8c-4b51-89c9-703d5e9a5f33"], Cell[
        TextData[{
         " ",
         Cell[BoxData[
          RowBox[{
           FractionBox["sin\[Theta]", "cos\[Theta]"], 
           SubscriptBox[
            StyleBox["m", "TI"], "1"], ","}]], "InlineFormula",ExpressionUUID->
          "8088b80f-616c-457f-829b-c4e9a031a65c"],
         " "
        }],ExpressionUUID->"e2a1ad30-5325-4f54-a18b-a7d0e0b04689"]},
       {Cell[TextData[{
