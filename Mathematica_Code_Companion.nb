             StyleBox["r", "TI"], 
             RowBox[{"(", 
              SubsuperscriptBox[
               StyleBox["h", "TI"], 
               StyleBox[
                RowBox[{"c", "d"}], "TI"], 
               RowBox[{"(", "2", ")"}]], ")"}], "\[CenterDot]", 
