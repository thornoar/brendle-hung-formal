        TextData[{
         " ",
         Cell[BoxData[
          RowBox[{
           SubscriptBox["\[Integral]", "\[CapitalSigma]"], "4", 
           RowBox[{"(", 
            RowBox[{
             SubscriptBox[
              StyleBox["P", "TI"], "0"], 
             StyleBox["Q", "TI"], 
             RowBox[{"(", 
              RowBox[{
               SubsuperscriptBox[
                StyleBox["h", "TI"], 
