 }], "DisplayFormula",ExpressionUUID->"f72c2b9b-d66c-48d1-b882-ec2ccefc2a7c"]
}], "Text",ExpressionUUID->"e6b90967-88f2-461b-bfd0-6e37680fca21"],

Cell[TextData[{
 "The following code uses the Koszul formula to compute ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox[
     RowBox[{"Connection", "[", " ", 
      RowBox[{"[", 
       RowBox[{"i", ",", "j", ",", "k"}], "]"}], " ", "]"}],
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "31553cf0-3a50-44b5-b816-65e5bd088163"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "85b57b62-c5e8-4aca-b89c-6c3cbfda5a15"],
 ":"
}], "Text",ExpressionUUID->"3d9185bb-802e-4ea0-9b93-b53ae86ff88f"],

Cell["\<\
Connection=Table[
1/2(
frameD[i, metric[[j, k]]] + frameD[j, metric[[i, k]]] - frameD[k, metric[[i, \
j]]] + 
cLow[[i, j, k]] - cLow[[j, k, i]] + cLow[[k, i, j]]
)*inversemetric[[k,k]],
{i,1,4},{j,1,4},{k,1,4}
];\
\>", "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"132c89e2-0a7a-4d0a-b52e-1336c92d96a2"],

Cell[TextData[{
 "The Riemannian curvature tensor is given by ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["R", "TI"], 
      StyleBox[
       RowBox[{"i", "j", "k", "l"}], "TI"]], "\[LongEqual]", 
     StyleBox["g", "TI"], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["D", "TI"], 
        SubscriptBox[
         StyleBox["m", "TI"], 
         StyleBox["i", "TI"]]], 
       SubscriptBox[
        StyleBox["D", "TI"], 
        SubscriptBox[
         StyleBox["m", "TI"], 
         StyleBox["j", "TI"]]], 
       SubscriptBox[
        StyleBox["m", "TI"], 
        StyleBox["l", "TI"]], "-", 
       SubscriptBox[
        StyleBox["D", "TI"], 
        SubscriptBox[
         StyleBox["m", "TI"], 
         StyleBox["j", "TI"]]], 
       SubscriptBox[
        StyleBox["D", "TI"], 
        SubscriptBox[
         StyleBox["m", "TI"], 
         StyleBox["i", "TI"]]], 
       SubscriptBox[
        StyleBox["m", "TI"], 
        StyleBox["l", "TI"]], "-", 
       SubscriptBox[
        StyleBox["D", "TI"], 
        RowBox[{"[", 
         RowBox[{
          SubscriptBox[
           StyleBox["m", "TI"], 
           StyleBox["i", "TI"]], ",", 
          SubscriptBox[
           StyleBox["m", "TI"], 
           StyleBox["j", "TI"]]}], "]"}]], 
       SubscriptBox[
        StyleBox["m", "TI"], 
        StyleBox["l", "TI"]], ",", 
       SubscriptBox[
        StyleBox["m", "TI"], 
        StyleBox["k", "TI"]]}], ")"}], "."}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"16b4248d-99af-4c20-ba83-53edd8658968"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "814ad8c4-ea9a-4922-bf55-687205ff12c8"],
 " In Mathematica ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox[
      RowBox[{"i", "j", "k", "l"}], "TI"]], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"e45e12f9-a1f5-4ca5-8d53-39df959d34bb"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "da7cd393-5bc9-4150-9ecf-083719e0ca86"],
 " is represented as ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox[
     RowBox[{"Rm", "[", " ", 
      RowBox[{"[", " ", 
       RowBox[{"i", ",", "j", ",", "k", ",", "l"}], " ", "]"}], " ", "]"}],
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "a869de14-1efd-48d4-9066-cacbbb93f244"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "97aa7b17-e026-45e3-a729-811c9d32e889"],
 ": ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["R", "TI"], 
      StyleBox[
       RowBox[{"i", "j", "k", "l"}], "TI"]], "\[LongEqual]", 
     StyleBox[
      RowBox[{"Rm", "[", " ", 
       RowBox[{"[", " ", 
        RowBox[{"i", ",", "j", ",", "k", ",", "l"}], " ", "]"}], " ", "]"}],
      FontSlant->"Plain"], "."}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"0dc028eb-7736-4055-b309-da23b70e0329"],
  "  "
 }], "DisplayFormula",ExpressionUUID->"92f21586-7d25-4b5b-aef1-c55d97c6c3e0"]
}], "Text",ExpressionUUID->"9a877180-e5bc-409a-8ffa-0b68a4801c51"],

Cell[TextData[{
 "In terms of the connection coefficients ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"i", "j"}], "TI"], 
     StyleBox["k", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "20226872-3567-4682-91b7-4c2849742ae6"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "ecc83acc-cf02-4513-b6a1-5104fde50016"],
 ", we have ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["R", "TI"], 
      StyleBox[
       RowBox[{"i", "j", "k", "l"}], "TI"]], "\[LongEqual]", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["m", "TI"], 
        StyleBox["i", "TI"]], 
       SubsuperscriptBox["\[CapitalGamma]", 
        StyleBox[
         RowBox[{"j", "l"}], "TI"], 
        StyleBox["p", "TI"]], "-", 
       SubscriptBox[
        StyleBox["m", "TI"], 
        StyleBox["j", "TI"]], 
       SubsuperscriptBox["\[CapitalGamma]", 
        StyleBox[
         RowBox[{"i", "l"}], "TI"], 
        StyleBox["p", "TI"]], "+", 
       SubsuperscriptBox["\[CapitalGamma]", 
        StyleBox[
         RowBox[{"j", "l"}], "TI"], 
        StyleBox["r", "TI"]], 
       SubsuperscriptBox["\[CapitalGamma]", 
        StyleBox[
         RowBox[{"i", "r"}], "TI"], 
        StyleBox["p", "TI"]], "-", 
       SubsuperscriptBox["\[CapitalGamma]", 
        StyleBox[
         RowBox[{"i", "l"}], "TI"], 
        StyleBox["r", "TI"]], 
       SubsuperscriptBox["\[CapitalGamma]", 
        StyleBox[
         RowBox[{"j", "r"}], "TI"], 
        StyleBox["p", "TI"]], "-", 
       SubsuperscriptBox[
        StyleBox["c", "TI"], 
        StyleBox[
         RowBox[{"i", "j"}], "TI"], 
        StyleBox["r", "TI"]], 
       SubsuperscriptBox["\[CapitalGamma]", 
        StyleBox[
         RowBox[{"r", "l"}], "TI"], 
        StyleBox["p", "TI"]]}], ")"}], 
     SubscriptBox[
      StyleBox["g", "TI"], 
      StyleBox[
       RowBox[{"p", "k"}], "TI"]], "."}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"e6603380-60b5-47ac-b9d4-abd84a608abb"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "65f9a969-49fe-4d16-8873-f2bc41ac947a"],
 " Hence Mathematica definition of ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox[
     RowBox[{"Rm", "[", 
      RowBox[{"[", 
       RowBox[{"i", ",", "j", ",", "k", ",", "l"}], "]"}], "]"}],
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "ca8a8b05-3fad-45ce-898c-2aad9b4aa628"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "aae52b25-bc01-4de5-987e-05125bddd09f"],
 " is as follows:"
}], "Text",ExpressionUUID->"0d189abe-7d2a-4565-b0c6-4d3cc3066a21"],

Cell["\<\

Rm=Table[
(
frameD[i,Connection[[j,l,k]]] - frameD[j,Connection[[i,l,k]]] +
Sum[
Connection[[j,l,r]]*Connection[[i,r,k]]
,{r,1,4}
]
-Sum[
Connection[[i,l,r]]*Connection[[j,r,k]]
,{r,1,4}]
-Sum[
c[[i,j,r]]*Connection[[r,l,k]]
,{r,1,4}
]
)*metric[[k,k]]
,{i,1,4},{j,1,4},{k,1,4},{l,1,4}
];\
\>", "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"91109836-0501-4f2e-8072-4646b12c9f0d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Differential Operators and Curvature Expansions", "Chapter",ExpressionUUID->"f627a091-7cc9-412b-aad7-c7a9bdc94b57"],

Cell[TextData[{
 "This section contains code for some differential operators that appear in \
the curvature expansion and the Morse-Bott formula. We begin with the \
covariant derivatives of ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    RowBox[{"(", 
     RowBox[{"0", ",", "2"}], ")"}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"257f8dca-ec5f-4239-b0c8-0f43aee23fb7"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "1f194195-7770-469d-bcea-71b9a319d3a0"],
 "- and ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    RowBox[{"(", 
     RowBox[{"0", ",", "3"}], ")"}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"84e2514d-5a4e-48ad-bda1-8d86f4401ed3"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "e0c74ba8-e935-427f-87fe-4df20d9aa326"],
 "-tensors. For a ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    RowBox[{"(", 
     RowBox[{"0", ",", "2"}], ")"}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"3056340e-69bd-4904-9f12-a59803a683d3"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "27d30c13-6190-46bb-bff6-5eec0bf1522d"],
 "-tensor ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox["h", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "b198675f-b6f2-4afa-ad69-cc092b0fc66d"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "7addf207-f8fb-43b5-9b86-830201f88aa5"],
 ", represented by ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox["h",
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "1b0641a1-cae9-4a70-bed3-48d1e05cdf77"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "b6a6faa7-9347-4529-9baa-1f5ee0d2f4d6"],
 ", ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox[
     RowBox[{"CovD2", "[", "h", "]"}],
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "a5138bea-16ce-4124-8db3-c23d7f36b5f6"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "a291ff63-50a6-4a24-8c6f-86982093dcc1"],
 " represents the covariant derivative of ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox["h", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "56be39c3-9b03-4861-9ba6-26ff7d79fd9a"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "fefe8d82-c11e-42ab-b615-79556a06ce95"],
 ":"
}], "Text",ExpressionUUID->"86d81935-2cbf-4af3-bd7f-ba408c92771c"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["D", "TI"], 
     StyleBox["i", "TI"]], 
    SubscriptBox[
     StyleBox["h", "TI"], 
     StyleBox[
      RowBox[{"j", "k"}], "TI"]], "\[LongEqual]", 
    StyleBox[
     RowBox[{
      RowBox[{"CovD2", "[", "h", "]"}], "[", " ", 
      RowBox[{"[", 
       RowBox[{"i", ",", "j", ",", "k"}], "]"}], " ", "]"}],
     FontSlant->"Plain"], "."}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e978a7f9-7a92-42b9-b010-7230e5578472"],
 "  "
}], "DisplayFormula",ExpressionUUID->"f39af7ff-06f6-4270-ab63-17929003fd96"],

Cell["\<\
CovD2[h_] := 
  Table[
  frameD[i, h[[j, k]]] - 
  Sum[Connection[[i, j, l]]*h[[l, k]]
      + Connection[[i, k, l]]*h[[j, l]], {l, 1, 4}], 
      {i, 1, 4}, {j, 1, 4}, {k, 1, 4}
     ];\
\>", "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"fa92799b-f43d-4e05-98d0-b468dbf2c480"],

Cell[TextData[{
 "For a ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    RowBox[{"(", 
     RowBox[{"0", ",", "3"}], ")"}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"f4a4cc90-95fa-4d55-868e-cde4a687d595"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "2a6e2529-c98d-4f1d-85dc-8a7578ce7c6e"],
 "-tensor ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox["A", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "da703c10-c3b4-44ca-b785-9e7d7c0d17ab"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "9d607a88-9b33-4ff6-a21e-c8939995cc75"],
 ", represented by ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox["A",
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "6fda3c5f-de7b-4121-a5f4-216627bc6096"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "9fe42966-0035-4c6e-82f5-355aaca42da1"],
 ", ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox[
     RowBox[{"CovD3", "[", "A", "]"}],
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "bf164ff0-2107-4b37-9556-0deda229640b"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "a6bd3470-35a1-4cf9-b98c-3a421e0061c1"],
 " represents the covariant derivative of ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox["A", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "5f559784-e213-4bed-bb5a-0dbc8d693d9d"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "1698e019-675b-40ff-a77b-44a6b9df635d"],
 "."
}], "Text",ExpressionUUID->"421383c8-0f42-42f3-a576-ee0169d6f2e0"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["D", "TI"], 
     StyleBox["i", "TI"]], 
    SubscriptBox[
     StyleBox["A", "TI"], 
     StyleBox[
      RowBox[{"j", "k", "l"}], "TI"]], "\[LongEqual]", 
    StyleBox[
     RowBox[{
      RowBox[{"CovD3", "[", "A", "]"}], "[", " ", 
      RowBox[{"[", 
       RowBox[{"i", ",", "j", ",", "k", ",", "l"}], "]"}], " ", "]"}],
     FontSlant->"Plain"], "."}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"10735c03-431e-4a14-bb84-16abc1cef64d"],
 "  "
}], "DisplayFormula",ExpressionUUID->"7ef793f9-2cf6-45a2-b19b-4fd1535999e4"],

Cell["\<\
CovD3[A_] := 
  Table[
  frameD[i, A[[j, k, l]]] - 
    Sum[Connection[[i, j, m]]*A[[m, k, l]]
      + Connection[[i, k, m]]*A[[j, m, l]]
      + Connection[[i, l, m]]*A[[j, k, m]], 
      {m, 1, 4}], {i, 1, 4}, {j,1, 4}, {k, 1, 4}, {l, 1, 4}
     ];\
\>", "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"2b2a2850-28c6-4cdc-95b7-a6b3aa687af3"],

Cell[TextData[{
 "Recall that ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox[
     RowBox[{"T", "h"}], "TI"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"82c4c268-02a6-4391-9436-e28fae386744"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "85f42559-70b7-47db-8f75-7b5f97141d93"],
 " and ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox[
     RowBox[{"L", "h"}], "TI"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"0d16965b-97ee-4c51-a59c-6e49de078fd7"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "2b28d3a3-fc2a-4e5c-a46b-c922e3a079a0"],
 " are given by ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      RowBox[{"(", 
       StyleBox[
        RowBox[{"T", "h"}], "TI"], ")"}], 
      StyleBox[
       RowBox[{"i", "j", "k"}], "TI"]], "\[LongEqual]", 
     FractionBox["1", "2"], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["D", "TI"], 
        StyleBox["i", "TI"]], 
       SubscriptBox[
        StyleBox["h", "TI"], 
        StyleBox[
         RowBox[{"j", "k"}], "TI"]], "+", 
       SubscriptBox[
        StyleBox["D", "TI"], 
        StyleBox["j", "TI"]], 
       SubscriptBox[
        StyleBox["h", "TI"], 
        StyleBox[
         RowBox[{"k", "i"}], "TI"]], "-", 
       SubscriptBox[
        StyleBox["D", "TI"], 
        StyleBox["k", "TI"]], 
       SubscriptBox[
        StyleBox["h", "TI"], 
        StyleBox[
         RowBox[{"i", "j"}], "TI"]]}], ")"}], ","}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"3fe8027d-2ec1-4e01-acb9-1b73c2890aad"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "1c6ea09e-d252-4fd6-98a5-66f060f7f850"],
