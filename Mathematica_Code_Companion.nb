Cell["\<\
rb=P1[L[hb]]//Simplify;
rd=P1[L[hd]]//Simplify;
zd=-Inverse[H].rd//Simplify;
Vbd=P0[L[hbd]]+P0[Q[hb,hd]]+1/2rb.zd;
Vbd=FullSimplify[Vbd,0<\[Theta]<\[Pi]/2];\
\>", "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"699609fe-6be9-4722-9437-28b0f3d0bb3d"],

