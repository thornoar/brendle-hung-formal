       }], TraditionalForm]],ExpressionUUID->
     "031a0726-356e-4867-81f2-94197ee183ca"], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"e2a08fb6-50da-4932-85e3-2b5265f8fa9c"],
