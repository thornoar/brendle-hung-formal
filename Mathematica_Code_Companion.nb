Cell["\<\
T[h_] := Module[{Dh},
Dh=CovD2[h];
Table[
  1/2*(
  Dh[[i, j, k]] + Dh[[j, k, i]] - Dh[[k, i, j]]), 
      {i, 1, 4}, {j, 1, 4}, {k, 1, 4}
      ]
]      \
\>", "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"21410d1f-071a-4843-ab6e-b2c6bb2554c8"],

Cell["\<\
L[h_] := Module[{Dh,DDh},
Dh=CovD2[h];
DDh=CovD3[Dh];
Table[
1/2*(-DDh[[i, k, j, l]] + DDh[[i, l, j, k]] + 
      DDh[[j, k, i, l]] - DDh[[j, l, i, k]]) +
Sum[
    1/2*inversemetric[[m, m]]*Rm[[i, j, k, m]]*h[[m, l]] - 
    1/2*inversemetric[[m, m]]*Rm[[i, j, l, m]]*h[[k, m]], 
    {m, 1, 4}
    ],
    {i, 1, 4}, {j, 1, 4}, {k, 1, 4}, {l, 1, 4}
    ]
]    \
\>", "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"c9e40f08-16af-4a4d-82ea-cb147a17869e"],

