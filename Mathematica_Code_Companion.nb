Cell[CellGroupData[{
Cell[TextData[{
 "Mathematica code companion: \"A metric on ",
 Cell[BoxData[Cell[TextData[{
   Cell[BoxData[
    FormBox[
     RowBox[{
      SuperscriptBox[
       StyleBox["S", "TI"], "2"], "\[Cross]", 
      SuperscriptBox[
       StyleBox["S", "TI"], "2"]}], TraditionalForm]], "InlineFormula",
    ExpressionUUID->"6f5f186c-30d7-43ba-a4f1-c7e9669eb539"],
   "  "
  }], "DisplayFormula",ExpressionUUID->
   "cef49571-fae3-4d7e-9fde-f6f3af6963a8"]],ExpressionUUID->
  "a37271e0-6c63-4cdd-a9e4-63678a2ce229"],
 " with positive sectional curvature.\""
}], "Title",ExpressionUUID->"420aec25-3cd4-4f22-b8af-e8258157c6bc"],

Cell["Simon Brendle and Pei-Ken Hung", "Author",
 CellChangeTimes->{{3.996496908516223*^9, 
  3.996496914556765*^9}},ExpressionUUID->"a4315a96-fa58-432f-a849-\
fb5f66cae157"],

Cell[CellGroupData[{

Cell["Connection and Curvature", "Chapter",ExpressionUUID->"a5d97572-575f-4138-a87d-0b047b937cdf"],

Cell[TextData[{
 "This section contains the code for computing the connection and Riemannian \
curvature tensor of the M\[UDoubleDot]ter metric. Recall that ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "23b00294-21c3-424c-bd57-0ce656492820"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "bab2b590-971a-49e6-be8a-2ce0fb8acc35"],
 ", ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    RowBox[{
     StyleBox["i", "TI"], 
     RowBox[{
      RowBox[{"\[LongEqual]", "1"}], ",", "2", ",", "3", ",", "4"}]}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "d1bb4927-4e0e-4931-851f-f320edb9acae"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "12bec239-0814-4824-a7b6-42494ed142d6"],
 " are vector fields defined on ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["S", "TI"], "2"], "\[Cross]", 
     SuperscriptBox[
      StyleBox["S", "TI"], "2"], "\\", 
     SubscriptBox["\[CapitalDelta]", "\[PlusMinus]"]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"262d6e9c-e925-4f2f-88e9-9d5349495e83"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "2e892ab0-d4f5-4bb8-958d-d68d4c04fbb1"],
 ". We write ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["g", "TI"], 
     StyleBox[
      RowBox[{"i", "j"}], "TI"]], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"d2a112cb-d433-4fb4-abcd-26c4233d100f"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "dd1bf422-ea23-4bef-a438-5a560e9c5fac"],
 " for ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    RowBox[{
     StyleBox["g", "TI"], "(", 
     RowBox[{
      SubscriptBox[
       StyleBox["m", "TI"], 
       StyleBox["i", "TI"]], ",", 
      SubscriptBox[
       StyleBox["m", "TI"], 
       StyleBox["j", "TI"]]}], ")"}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"d80d4a0f-6a3b-42bb-b6ce-1bb5f59360e4"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "b57e507b-5566-4d09-9d87-d80aad248808"],
 ", and ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    SuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox[
      RowBox[{"i", "j"}], "TI"]], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"ceb6b743-4ae9-4cc5-9ecf-0b4b0051ed0c"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "7ab916b7-603b-4824-a149-2057ffa5ed91"],
 " for the inverse metric. In Mathematica, ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["g", "TI"], 
     StyleBox[
      RowBox[{"i", "j"}], "TI"]], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"f312294a-9208-4725-9ed9-0d90cbeda460"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "b2d52520-56f0-4034-a4bf-8da9fb97e0ff"],
 " and ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    SuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox[
      RowBox[{"i", "j"}], "TI"]], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"70266af1-e94f-41d3-9515-92fc315719e7"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "a17a4195-1356-41fa-9347-d639131c6226"],
 " are represented as ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox[
     RowBox[{"metric", " ", "[", " ", 
      RowBox[{"[", 
       RowBox[{"i", ",", "j"}], "]"}], " ", "]"}],
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "18cd34b6-e646-4eac-b417-0c8f7c261e57"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "9b1908ec-62fe-4b76-86db-9f6cfb86b061"],
 " and ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox[
     RowBox[{"inversemetric", " ", "[", " ", 
      RowBox[{"[", 
       RowBox[{"i", ",", "j"}], "]"}], " ", "]"}],
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "af97c422-a899-47d8-b5cc-53d76e9e379c"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "29db1c1b-f96e-4cde-bce0-d6119878c5e6"],
 " respectively:"
}], "Text",ExpressionUUID->"841f95a2-0b8a-4c7b-8cbf-5a1074709cb1"],

Cell[TextData[{
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["g", "TI"], 
      StyleBox[
       RowBox[{"i", "j"}], "TI"]], "\[LongEqual]", 
     StyleBox[
      RowBox[{"metric", "[", " ", 
       RowBox[{"[", 
        RowBox[{"i", ",", "j"}], "]"}], " ", "]"}],
      FontSlant->"Plain"], ","}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"3c6f9fec-356e-4771-82e4-bf59e7516f95"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "54851fbd-3fea-42c8-9ecd-dbbbb3a368be"],
 " ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["g", "TI"], 
      StyleBox[
       RowBox[{"i", "j"}], "TI"]], "\[LongEqual]", 
     StyleBox[
      RowBox[{"inversemetric", " ", "[", " ", 
       RowBox[{"[", 
        RowBox[{"i", ",", "j"}], "]"}], " ", "]"}],
      FontSlant->"Plain"], "."}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"08548007-efdb-4cf7-865a-09851841410d"],
  "  "
 }], "DisplayFormula",ExpressionUUID->"476cd28f-c663-450a-9a8e-93f4522d62b8"]
}], "Text",ExpressionUUID->"5ffce717-6aeb-49e3-a094-e9c00eb5f474"],

Cell["Because", "Text",ExpressionUUID->"5fe9684e-4c2b-4d47-b176-7fff86c10c8d"],

