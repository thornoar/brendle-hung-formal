 }], "DisplayFormula",ExpressionUUID->
  "34ff3a21-2c0f-4810-a9d6-2e8b4fc9bc11"],
 ", represented as ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox["Vaa",
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "d65528e4-1e4c-4685-be85-3b4dad00fff9"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "74f4d339-1e69-4a23-b25c-6f92a0c93c28"],
 "."
}], "Text",ExpressionUUID->"b804e3cc-c51b-4ee0-bf4f-bdf370d5e014"],

Cell["\<\
ra=P1[L[ha]]//Simplify;
za=-Inverse[H].ra//Simplify;
Vaa=P0[L[haa]]+P0[Q[ha,ha]]+1/2ra.za;
Vaa=FullSimplify[Vaa,0<\[Theta]<\[Pi]/2];\
\>", "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"76c001cd-1809-46cc-bd17-6f79859dfe04"],

Cell["We then verify that", "Text",ExpressionUUID->"8e189ecb-8176-4850-8d3a-901933be04ea"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["V", "TI"], 
     StyleBox[
      RowBox[{"a", "a"}], "TI"], 
     RowBox[{"(", "2", ")"}]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{"-", 
      FractionBox["3472117", "384"], "+", 
      FractionBox["42025", "6"], 
      SqrtBox[
       FractionBox["5", "3"]]}], ")"}], 
    SuperscriptBox[
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{
       SubscriptBox[
        StyleBox["q", "TI"], "3"], ",", 
       SubscriptBox[
        StyleBox["e", "TI"], 
        StyleBox["x", "TI"]]}], "\[RightAngleBracket]"}], "2"], "."}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "0f855ede-cde1-48bb-bd66-18cb7eb36a00"],
 "  "
}], "DisplayFormula",ExpressionUUID->"3966495a-d566-44c8-ba24-7766720e6774"],

Cell[CellGroupData[{

Cell["\<\
VaaExp=(-3472117/384+42025/6*Sqrt[5/3])*q3x^2;
(Vaa-VaaExp//Simplify) == 0\
\>", "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"dfca687c-4e6c-4fbb-ace0-611e36584ee6"],

Cell[BoxData["\<\"\"\>"], "Output",
 CellLabel->"Out[1]=",ExpressionUUID->"7039931e-46ca-4c08-be35-7fb128762c31"]
}, Open  ]]
