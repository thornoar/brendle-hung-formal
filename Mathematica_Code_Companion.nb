Cell["\<\
rb=P1[L[hb]]//Simplify;
zb=-Inverse[H].rb//Simplify;
Vbb=P0[L[hbb]]+P0[Q[hb,hb]]+1/2rb.zb;
Vbb=FullSimplify[Vbb,0<\[Theta]<\[Pi]/2];\
\>", "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"b71b851d-a5f5-456b-a760-509b3afd2ec3"],

Cell["We then verify that", "Text",ExpressionUUID->"8dbdef5c-e022-43d7-adfd-4baa26c982f3"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["V", "TI"], 
     StyleBox[
      RowBox[{"b", "b"}], "TI"], 
     RowBox[{"(", "2", ")"}]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{"-", 
      FractionBox["3472117", "384"], "+", 
      FractionBox["42025", "6"], 
      SqrtBox[
       FractionBox["5", "3"]]}], ")"}], 
    SuperscriptBox[
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{
       SubscriptBox[
        StyleBox["q", "TI"], "3"], ",", 
       SubscriptBox[
        StyleBox["e", "TI"], 
        StyleBox["y", "TI"]]}], "\[RightAngleBracket]"}], "2"], "."}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "be94e858-2b06-48d4-9b3b-c16fe824a800"],
 "  "
}], "DisplayFormula",ExpressionUUID->"b82b0737-39a0-4815-b881-13ad26ec23ef"],

Cell[CellGroupData[{

Cell["\<\
VbbExp = (-3472117/384+42025/6*Sqrt[5/3])*q3y^2;
(Vbb-VbbExp//Simplify) == 0\
\>", "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"f08d1d02-75b4-4f95-b211-bbcf377b5fe0"],

Cell[BoxData["\<\"\"\>"], "Output",
 CellLabel->"Out[1]=",ExpressionUUID->"be6eebe0-18bb-4078-ba88-208e16234068"]
}, Open  ]]
}, Open  ]],

