     StyleBox[
      RowBox[{"i", "j", "k", "l"}], "TI"]], "\[LongEqual]", 
    StyleBox[
     RowBox[{
      RowBox[{"Cubic", "[", 
       RowBox[{"h1", ",", "h2", ",", "h3"}], "]"}], "[", " ", 
      RowBox[{"[", 
       RowBox[{"i", ",", "j", ",", "k", ",", "l"}], "]"}], " ", "]"}],
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "003926ef-6d86-4f78-9dee-102fa4fe8e5b"],
 "  "
}], "DisplayFormula",ExpressionUUID->"5a99a786-8518-48a9-b9e4-787dbbdfb8a7"],

Cell["\<\
Cubic[h1_,h2_,h3_] := Module[{T2,T3},
T2=T[h2];
T3=T[h3];
Table[
Sum[
inversemetric[[m,m]]*inversemetric[[r,r]]*h1[[m,r]]*
(-T2[[j,k,m]]*T3[[i,l,r]]+T2[[i,k,m]]*T3[[j,l,r]]),
{m,1,4},{r,1,4}
],
{i,1,4},{j,1,4},{k,1,4},{l,1,4}
]
]\
\>", "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"1e461dd7-f9b1-457f-aa8d-44595d6c55cd"],

