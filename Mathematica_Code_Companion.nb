Cell[TextData[{
 "Hence the Mathematica representation of ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["h", "TI"], 
     StyleBox[
      RowBox[{"a", "a"}], "TI"], 
     RowBox[{"(", "2", ")"}]], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"a4b90e13-6bec-4cd0-93e5-12502e863dca"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "59f19a60-f3a9-41f4-a297-1abc36247313"],
 ", ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox["haa",
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "035c5542-424d-47e3-834d-a94324277ed3"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "e25c8084-915e-4f2f-b337-85b1587f31ab"],
 ", is defined as follows:"
}], "Text",ExpressionUUID->"3cd76c01-4f18-46f2-8708-df5c64470042"],

Cell["\<\
faa=-2203841 Cos[2 \[Theta]]/1920 + 5579141 Cos[4 \[Theta]]/153600 - 214597 \
Cos[6 \[Theta]]/103680 +
     48211 Cos[8 \[Theta]]/307200 - 251 Cos[10 \[Theta]]/19200 + 25 Cos[12 \
\[Theta]]/165888 - 
     42025/12 Sqrt[5/3] PolyLog[2, (-4 + Sqrt[15]) E^(-2 I \[Theta])] - 
     42025/12 Sqrt[5/3] PolyLog[2, (-4 + Sqrt[15]) E^(2 I \[Theta])];
haa=9*faa*Transpose[K[ex]] . K[ex];     \
\>", "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"6e6c4ccc-7015-45a2-b211-e426b77483ed"],

