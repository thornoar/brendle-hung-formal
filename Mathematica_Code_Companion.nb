Cell["\<\
Q[h1_, h2_] := Module[{T1,T2},
T1=T[h1];
T2=T[h2];
Table[
Sum[
inversemetric[[m, m]]*(
      T1[[j, k, m]]*T2[[i, l, m]]/2 -
       T1[[i, k, m]]*T2[[j, l, m]]/2 +
       T2[[j, k, m]]*T1[[i, l, m]]/2 -
       T2[[i, k, m]]*T1[[j, l, m]]/2), 
      {m, 1, 4}
      ], 
      {i, 1, 4}, {j, 1, 4}, {k, 1, 4}, {l, 1, 4}
      ]
]      \
\>", "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"ff317edb-5b45-4eae-b535-8b66ef3fc76b"],

