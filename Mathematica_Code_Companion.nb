Cell[TextData[{
 "the Mathematica definitions ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox[
     RowBox[{"metric", "[", " ", 
      RowBox[{"[", 
       RowBox[{"i", ",", "j"}], "]"}], " ", "]"}],
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "831763fd-0ee8-47b8-a3d2-7f5be88c3d65"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "4c7c3620-c5a9-4687-a935-c79e5d6ce06b"],
 " and ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox[
     RowBox[{"inversemetric", " ", "[", " ", 
      RowBox[{"[", 
       RowBox[{"i", ",", "j"}], "]"}], " ", "]"}],
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "1d18514e-8143-4bb8-8098-4252ae72ba38"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "18e680fd-2c16-4d84-9b97-57b0b5898aa7"],
 " are as follows:"
}], "Text",ExpressionUUID->"516db421-7f91-405a-8a50-79ffe37f6716"],

Cell["\<\
metric = {
{1/(2 - Cos[2 \[Theta]]), 0, 0, 0},
{0, 1/(2 + Cos[2 \[Theta]]), 0, 0},
{0, 0, 1/3, 0},
{0, 0, 0, 1}
};
inversemetric=Inverse[metric];\
\>", "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"7a4cbafc-549a-422e-8b58-c8ca7d1d3244"],

Cell[TextData[{
 "Let ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    SubsuperscriptBox[
     StyleBox["c", "TI"], 
     StyleBox[
      RowBox[{"i", "j"}], "TI"], 
     StyleBox["k", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "a259c65f-c592-47d2-ae0c-8349df1e0f3c"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "a2cb54d7-3512-49fd-9234-1ecf8657b554"],
 " be the coefficients in the Lie brackets of ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "491a123d-d2f7-4df8-923c-e92bb6abd6d2"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "0f65359f-75e5-4e31-83a5-630d3913f47d"],
 ": ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    RowBox[{
     RowBox[{"[", 
      RowBox[{
       SubscriptBox[
        StyleBox["m", "TI"], 
        StyleBox["i", "TI"]], ",", 
       SubscriptBox[
        StyleBox["m", "TI"], 
        StyleBox["j", "TI"]]}], "]"}], "\[LongEqual]", 
     SubsuperscriptBox[
      StyleBox["c", "TI"], 
      StyleBox[
       RowBox[{"i", "j"}], "TI"], 
      StyleBox["k", "TI"]], 
     SubscriptBox[
      StyleBox["m", "TI"], 
      StyleBox["k", "TI"]], "."}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"da834ee8-2481-481e-bb10-b8d7d8dcd2fe"],
  "  "
 }], "DisplayFormula",ExpressionUUID->"ef63672f-5686-4f55-a824-46c29725889e"]
}], "Text",ExpressionUUID->"43cabec2-c265-4219-9c48-3c20e427fb75"],

