 "."
}], "Text",ExpressionUUID->"1ea65fb7-668a-401a-8299-db49b6b56bce"],

Cell["\<\
rd=P1[L[hd]]//Simplify;
zd=-Inverse[H].rd//Simplify;
A41=2P1[Q[hc,hd]].zd;
A42=1/2*Transpose[zd].P2[L[hc]].zd;
A4=A41+A42;\
\>", "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"793b96ea-cc7b-4e71-8731-37f087f50aa9"],

Cell[TextData[{
 "We restrict ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["A", "TI"], "4"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"cf2fc3f4-ed2e-4031-b522-b5c79db97862"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "e38cd390-121c-4a70-be6c-4a4102da5ed9"],
 " to ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    SubscriptBox["\[CapitalSigma]", "+"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"2c683ae2-23a6-4fd5-92f7-c93fe17609bf"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "63958b12-e00f-4ee2-80b9-88f9a63d1a28"],
 ", and check that under the above parametrization, we have ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["A", "TI"], "4"], "\[LongEqual]", 
     FractionBox["1", "36"], "-", 
     FractionBox[
      RowBox[{"cos", 
       RowBox[{"(", 
        RowBox[{"2", "\[Theta]"}], ")"}], "cos", 
       RowBox[{"(", 
        RowBox[{"2", "\[Phi]"}], ")"}]}], 
      RowBox[{"6", 
       RowBox[{"(", 
        RowBox[{"7", "-", 
         RowBox[{"cos", 
          RowBox[{"(", 
           RowBox[{"4", "\[Theta]"}], ")"}]}]}], ")"}]}]], "."}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "90a087f6-6d69-4fd9-8b3e-ab22a812acde"],
  "  "
 }], "DisplayFormula",ExpressionUUID->"1e2aba44-e72f-417a-bcd2-3d5433654012"]
}], "Text",ExpressionUUID->"cb7097a9-9ebe-4169-b343-a33f87c30734"],

Cell[CellGroupData[{

Cell["\<\
pA4=A4/.pTorus//Simplify;
pA4Exp=1/36 - (Cos[2 \[Theta]]*Cos[2 \[Phi]])/(6(7 - Cos[4 \[Theta]]));
(pA4-pA4Exp//Simplify) == 0\
\>", "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"f416af28-18be-4793-9e22-e6454d837ac5"],

Cell[BoxData["\<\"\"\>"], "Output",
 CellLabel->"Out[1]=",ExpressionUUID->"93c66200-83e4-4bff-bc20-2d29208cf1aa"]
}, Open  ]],

