Cell["\<\
fbb=2203841 Cos[2 \[Theta]]/1920 + 5579141 Cos[4 \[Theta]]/153600 + 214597 \
Cos[6 \[Theta]]/103680 + 
    48211 Cos[8 \[Theta]]/307200 + 251 Cos[10 \[Theta]]/19200 + 25 Cos[12 \
\[Theta]]/165888 - 
    42025/12 Sqrt[5/3]PolyLog[2, (4 - Sqrt[15]) E^(-2 I \[Theta])] - 
    42025/12 Sqrt[5/3] PolyLog[2, (4 - Sqrt[15]) E^(2 I \[Theta])];
hbb=9*fbb*Transpose[K[ey]] . K[ey];    \
\>", "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"5b0fd644-35f7-45de-a1c5-f7a0a720eb1a"],

