           ExpressionUUID->"a3f18924-8f6b-4785-ad58-3187f90d190f"],
          " "
         }],ExpressionUUID->"8d7eca6c-7684-41af-a62e-c66def3c5ad9"]},
        {Cell[TextData[{
          " ",
          Cell[
          "\[Null]", "InlineFormula",ExpressionUUID->
           "60e04dbc-6126-4859-bcd7-520942578f74"],
          " "
         }],ExpressionUUID->"dcbb1e66-3640-4159-bfcc-5f7bcbc4fc52"], Cell[
         TextData[{
          " ",
          Cell[BoxData[
           RowBox[{"+", 
