   "9505fe56-1219-4c86-978c-74c4c501d633"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "125d2018-6bdd-472e-b177-11f26e7f7be3"],
 ", is defined as follows:"
}], "Text",ExpressionUUID->"39c6b32d-5609-4367-a5e9-9944a3bf49fd"],

Cell["\<\
hbd=9/40*q1x*Cos[\[Theta]] (-(406/45) + 92/45 Cos[2 \[Theta]] + 2/5 Cos[4 \
\[Theta]])*
(Transpose[K[ey]] . K[ez] + Transpose[K[ez]] . K[ey])/2 +
   9*q1z*Cos[\[Theta]] (-(823/900) - 77/450 Cos[2 \[Theta]] + 1/100 Cos[4 \
\[Theta]])*
   (Transpose[K[ey]] . K[ex] + Transpose[K[ex]] . K[ey])/2 // Simplify;\
\>", "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"ad6cda57-d45a-4cde-b4e3-2aeca252c227"],

