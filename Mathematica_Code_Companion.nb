}], "DisplayFormula",ExpressionUUID->"9e6d2654-b01c-4d2f-a325-ebc323fd81ac"],

Cell[TextData[{
 "Hence the Mathematica definition of ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox[
     RowBox[{"c", "[", " ", 
      RowBox[{"[", 
       RowBox[{"i", ",", "j", ",", "k"}], "]"}], " ", "]"}],
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "0de85efe-5c20-4043-8deb-034f4d8240bf"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "77d64494-e06e-417c-a92c-533f5be265f8"],
 " is as follows:"
}], "Text",ExpressionUUID->"eb530998-c21c-4b05-ad2b-5065f47c9f87"],

Cell["\<\
ClearAll[c];
c=Table[0,{i,1,4},{j,1,4},{k,1,4}];
c[[1,2,3]]=1/(Sin[\[Theta]]Cos[\[Theta]]);
c[[2,1,3]]=-1/(Sin[\[Theta]]Cos[\[Theta]]);
c[[1,3,2]]=-Cos[\[Theta]]/Sin[\[Theta]];
c[[3,1,2]]=Cos[\[Theta]]/Sin[\[Theta]];
c[[1,4,1]]=Cos[\[Theta]]/Sin[\[Theta]];
c[[4,1,1]]=-Cos[\[Theta]]/Sin[\[Theta]];
c[[2,3,1]]=Sin[\[Theta]]/Cos[\[Theta]];
c[[3,2,1]]=-Sin[\[Theta]]/Cos[\[Theta]];
c[[2,4,2]]=-Sin[\[Theta]]/Cos[\[Theta]];
c[[4,2,2]]=Sin[\[Theta]]/Cos[\[Theta]];\
\>", "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"e7d6b9ae-f9e1-4af7-a66d-f480da3e3db0"],

Cell[TextData[{
 "We define ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox["cLow",
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "366ad8fe-0537-433f-b411-9d90cc6fecba"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "025d1c7d-15d3-405c-9077-153caa1bb83e"],
 " by ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    RowBox[{
     StyleBox["g", "TI"], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"[", 
        RowBox[{
         SubscriptBox[
          StyleBox["m", "TI"], 
          StyleBox["i", "TI"]], ",", 
         SubscriptBox[
          StyleBox["m", "TI"], 
          StyleBox["j", "TI"]]}], "]"}], ",", 
       SubscriptBox[
        StyleBox["m", "TI"], 
        StyleBox["k", "TI"]]}], ")"}], "\[LongEqual]", 
     StyleBox[
      RowBox[{"cLow", "[", " ", 
       RowBox[{"[", 
        RowBox[{"i", ",", "j", ",", "k"}], "]"}], " ", "]"}],
      FontSlant->"Plain"], "."}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"47920de2-814d-42f7-afa4-ce29f39f2f60"],
  "  "
 }], "DisplayFormula",ExpressionUUID->"fe5741fa-cfee-4550-9ac0-674282a15616"]
}], "Text",ExpressionUUID->"c3a7a0f9-deed-48aa-be18-9754adabe743"],

Cell["\<\
cLow=Table[c[[i,j,k]]*metric[[k,k]],{i,1,4},{j,1,4},{k,1,4}];\
\>", "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"a2ac1324-9f6e-4d54-941b-daf22130f8f6"],

Cell[TextData[{
 "Next, we define the directional derivative of a scalar function ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox["A", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "3ff18926-985e-42e2-ac6d-5354cbe15d20"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "03a7f0b6-b76f-4bb3-bc3d-d646745f2c17"],
 " along the direction ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "d684c5c4-8c4b-4754-b6fc-b7db99367789"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "4e50028e-f1d5-4cf0-855e-413fe6d0484a"],
 ". All the quantities to which we apply directional derivatives are \
functions of ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox["\[Theta]", TraditionalForm]], "InlineFormula",ExpressionUUID->
   "b6ec6439-f9e8-4266-96d9-7786d5e08a49"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "6c0628c5-ea04-4c65-b85f-e3c3120fbd88"],
 ", ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["q", "TI"], "1"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"723fc9b5-2422-4685-b4be-b9b6dadb660a"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "358d3cf3-d594-4d1a-9fee-7cfe68bc4763"],
 ", ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["q", "TI"], "2"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"fb357d3b-5e33-44ee-bff0-3531fde64b4a"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "5d1ecb97-1db5-4b9e-980e-bc34527064fa"],
 ", and ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["q", "TI"], "3"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"1f4b341b-934b-40b9-b3c4-4e1d78532afb"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "ca3b306a-a5f3-46bb-ab7e-e47121dbb9c8"],
 ". Let ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox["A", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "3a5cdbb0-78e0-4a85-92ca-311ea6433dbc"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "979dea0c-8492-4e04-8d52-6548922b8275"],
 " be a scalar function, represented as ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox["A",
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "cb9f7482-9028-49df-adc2-f234d4043c2e"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "dbe9a6a2-b0d5-4527-94fb-dc222f82819d"],
 " in Mathematica. We define ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox["frameD",
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "89a16581-22f4-4e02-ac54-8ff316655764"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "4843fe56-708d-4241-8ffa-c07eb11f12f5"],
 " such that ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["m", "TI"], 
      StyleBox["i", "TI"]], 
     StyleBox["A", "TI"], "\[LongEqual]", 
     StyleBox[
      RowBox[{"frameD", "[", 
       RowBox[{"i", ",", "A"}], "]"}],
      FontSlant->"Plain"], "."}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"0eeeda66-a6d4-4b0d-821d-5b558e6f37ac"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "06179c00-9ede-4b7d-9deb-0792f20de26d"],
 " Using ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["E", "TI"], 
      StyleBox["i", "TI"]], 
     SubscriptBox[
      StyleBox["q", "TI"], 
      StyleBox["j", "TI"]], "\[LongEqual]", 
     SubscriptBox["\[Epsilon]", 
      StyleBox[
       RowBox[{"i", "j", "k"}], "TI"]], 
     SubscriptBox[
      StyleBox["q", "TI"], 
      StyleBox["k", "TI"]], ","}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"5c448e08-9365-4523-a74c-d6cb68c76d65"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "33307c5f-854c-43a1-b3e3-3b3290612b4e"],
 " and expressing the components of ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "d5f33f1f-69de-4b1d-98b3-36e8fc2e25bf"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "5384c5fc-a878-4bab-b7d5-662aa4d3834c"],
 " as ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["q", "TI"], 
       StyleBox[
        RowBox[{"i", "x"}], "TI"]], ",", 
      SubscriptBox[
       StyleBox["q", "TI"], 
       StyleBox[
        RowBox[{"i", "y"}], "TI"]], ",", 
      SubscriptBox[
       StyleBox["q", "TI"], 
       StyleBox[
        RowBox[{"i", "z"}], "TI"]]}], ")"}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"71baf79e-1ad1-4128-b861-32553fe56a1d"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "1a6f3dd3-d085-4350-b781-68facc64405a"],
 ", we have"
}], "Text",ExpressionUUID->"ba68f2c4-e7be-4cc3-be1c-fca56c82b326"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[Cell[BoxData[
    FormBox[GridBox[{
       {Cell[TextData[{
         " ",
         Cell[BoxData[
          RowBox[{
           SubscriptBox[
            StyleBox["m", "TI"], "1"], 
           StyleBox["A", "TI"], "\[LongEqual]"}]], "InlineFormula",
          ExpressionUUID->"a73d503d-6ff6-4b60-817a-19f5d1b315e6"],
         " "
        }],ExpressionUUID->"e125f026-9798-4d93-9403-1529177abd1b"], Cell[
        TextData[{
         " ",
         Cell[BoxData[
          RowBox[{
           FractionBox["1", "sin\[Theta]"], 
           RowBox[{"(", 
            RowBox[{
             UnderscriptBox["\[Sum]", 
              RowBox[{
               RowBox[{"*", "\[LongEqual]"}], 
               StyleBox["x", "TI"], ",", 
               StyleBox["y", "TI"], ",", 
               StyleBox["z", "TI"]}],
              LimitsPositioning->True], 
             SubscriptBox[
              StyleBox["q", "TI"], 
              RowBox[{"3", "*"}]], 
             SubscriptBox["\[PartialD]", 
              SubscriptBox[
               StyleBox["q", "TI"], 
               RowBox[{"2", "*"}]]], 
             StyleBox["A", "TI"], "-", 
             SubscriptBox[
              StyleBox["q", "TI"], 
              RowBox[{"2", "*"}]], 
             SubscriptBox["\[PartialD]", 
              SubscriptBox[
               StyleBox["q", "TI"], 
               RowBox[{"3", "*"}]]], 
             StyleBox["A", "TI"]}], ")"}], ","}]], "InlineFormula",
          ExpressionUUID->"14b4789c-9dda-42b8-8132-287135f0d093"],
         " "
        }],ExpressionUUID->"9017e3a4-5e49-4303-89d7-b29424435f8e"]},
       {Cell[TextData[{
         " ",
         Cell[BoxData[
          RowBox[{
           SubscriptBox[
            StyleBox["m", "TI"], "2"], 
           StyleBox["A", "TI"], "\[LongEqual]"}]], "InlineFormula",
          ExpressionUUID->"1488f466-103e-4c6a-9b03-3cd376741c06"],
         " "
        }],ExpressionUUID->"43587e2f-45c0-44eb-99db-cfea28d0683b"], Cell[
        TextData[{
         " ",
         Cell[BoxData[
          RowBox[{
           FractionBox["1", "cos\[Theta]"], 
           RowBox[{"(", 
            RowBox[{
             UnderscriptBox["\[Sum]", 
              RowBox[{
               RowBox[{"*", "\[LongEqual]"}], 
               StyleBox["x", "TI"], ",", 
               StyleBox["y", "TI"], ",", 
               StyleBox["z", "TI"]}],
              LimitsPositioning->True], 
             SubscriptBox[
              StyleBox["q", "TI"], 
              RowBox[{"1", "*"}]], 
             SubscriptBox["\[PartialD]", 
              SubscriptBox[
               StyleBox["q", "TI"], 
               RowBox[{"3", "*"}]]], 
             StyleBox["A", "TI"], "-", 
             SubscriptBox[
              StyleBox["q", "TI"], 
              RowBox[{"3", "*"}]], 
             SubscriptBox["\[PartialD]", 
              SubscriptBox[
               StyleBox["q", "TI"], 
               RowBox[{"1", "*"}]]], 
             StyleBox["A", "TI"]}], ")"}], ","}]], "InlineFormula",
          ExpressionUUID->"7c64acd4-159c-4dbe-be20-94cb1d114f2f"],
         " "
        }],ExpressionUUID->"4ddb10e0-d765-4f22-aa8d-98fe7d9c6d6e"]},
       {Cell[TextData[{
         " ",
         Cell[BoxData[
          RowBox[{
           SubscriptBox[
            StyleBox["m", "TI"], "3"], 
           StyleBox["A", "TI"], "\[LongEqual]"}]], "InlineFormula",
          ExpressionUUID->"e1a07fd6-e76c-419a-8d2d-1c44466ec637"],
         " "
        }],ExpressionUUID->"b8f0eb55-d3a2-4ee9-b715-41858eebd811"], Cell[
        TextData[{
         " ",
         Cell[BoxData[
          RowBox[{
           UnderscriptBox["\[Sum]", 
            RowBox[{
             RowBox[{"*", "\[LongEqual]"}], 
             StyleBox["x", "TI"], ",", 
             StyleBox["y", "TI"], ",", 
             StyleBox["z", "TI"]}],
            LimitsPositioning->True], 
           RowBox[{"(", 
            RowBox[{
             SubscriptBox[
              StyleBox["q", "TI"], 
              RowBox[{"2", "*"}]], 
             SubscriptBox["\[PartialD]", 
              SubscriptBox[
               StyleBox["q", "TI"], 
               RowBox[{"1", "*"}]]], 
             StyleBox["A", "TI"], "-", 
             SubscriptBox[
              StyleBox["q", "TI"], 
              RowBox[{"1", "*"}]], 
             SubscriptBox["\[PartialD]", 
              SubscriptBox[
               StyleBox["q", "TI"], 
               RowBox[{"2", "*"}]]], 
             StyleBox["A", "TI"]}], ")"}], ","}]], "InlineFormula",
          ExpressionUUID->"5fd78ecd-be26-4982-8939-476a0fee597b"],
         " "
        }],ExpressionUUID->"029a0525-71e4-4faa-a9dc-38f4fa6c31f0"]}
      }], TraditionalForm]],ExpressionUUID->
    "cb32d8dc-1502-46bc-8eb4-1c9394660dbf"], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"37da3926-aa33-4cc6-beef-0fa03944c3f2"],
 "  "
}], "DisplayFormula",ExpressionUUID->"4b006bff-2bad-4dd3-a24d-2ac81c6d808a"],

Cell["and", "Text",ExpressionUUID->"4eb65d31-c035-46f9-ac3f-2415ac27b915"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], "4"], 
    StyleBox["A", "TI"], "\[LongEqual]", 
    SubscriptBox["\[PartialD]", "\[Theta]"], 
    StyleBox["A", "TI"], "."}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"7bbab2d5-fab0-477c-bbb5-6f94449db444"],
 "  "
}], "DisplayFormula",ExpressionUUID->"c7e9a6d7-d92a-4950-9088-9a839721c385"],

Cell[TextData[{
 "Then the Mathematica definition of ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox["frameD",
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "f1b5bf6a-6c24-4954-9505-a86d90e77d91"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "7dc51df8-d2af-4f58-be6f-c640bb51bc27"],
 " is as follows:"
}], "Text",ExpressionUUID->"b63ae371-7c81-4516-b2d5-25ababea62ef"],

Cell["\<\
frameD[1, expr_] := (
q3x*D[expr, q2x] + q3y*D[expr, q2y] + q3z*D[expr, q2z] -
q2x*D[expr, q3x] - q2y*D[expr, q3y] - q2z*D[expr, q3z]
     )/Sin[\[Theta]];
frameD[2, expr_] := (
q1x*D[expr, q3x] + q1y*D[expr, q3y]+ q1z*D[expr, q3z] -
q3x*D[expr, q1x] - q3y*D[expr, q1y] - q3z*D[expr, q1z]
     )/Cos[\[Theta]];
frameD[3, expr_] := (
q2x*D[expr, q1x] + q2y*D[expr, q1y] + q2z*D[expr, q1z] -
q1x*D[expr, q2x] - q1y*D[expr, q2y] - q1z*D[expr, q2z]
    );
frameD[4, expr_] := D[expr, \[Theta]];\
\>", "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"0f52b20f-7a22-4b98-8874-619a4cc62492"],

Cell[TextData[{
 "Let ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"i", "j"}], "TI"], 
     StyleBox["k", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "f5cbfe60-30f2-4a07-af77-e447ffa2c1a8"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "96a2140c-23a0-44d6-b6d9-214c7957ec99"],
 " be the connection coefficients given by ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["D", "TI"], 
      SubscriptBox[
       StyleBox["m", "TI"], 
       StyleBox["i", "TI"]]], 
     SubscriptBox[
      StyleBox["m", "TI"], 
      StyleBox["j", "TI"]], "\[LongEqual]", 
     SubsuperscriptBox["\[CapitalGamma]", 
      StyleBox[
       RowBox[{"i", "j"}], "TI"], 
      StyleBox["k", "TI"]], 
     SubscriptBox[
      StyleBox["m", "TI"], 
      StyleBox["k", "TI"]], "."}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"67bcb52a-3e66-4a66-914b-2dcb15defd99"],
  "  "
 }], "DisplayFormula",ExpressionUUID->"5c70978b-b8e4-4011-8355-5c8b5cfbd69c"]
}], "Text",ExpressionUUID->"404c8853-0191-4830-bbf6-b509b248310e"],

Cell[TextData[{
 "In Mathematica ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"i", "j"}], "TI"], 
     StyleBox["k", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "13c5eca6-3699-416f-96b4-991225053da5"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "21169721-e19d-4b71-8bc8-2e620f28d101"],
 " is represented as ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox["Connection",
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "fe52d6b3-12c5-4f77-b398-145312984efe"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "d3b546b1-44c5-4140-9de3-80804bf5a3f0"],
 ":"
}], "Text",ExpressionUUID->"8cfba9e3-a3ab-4fdd-bbe4-45626d7e8ca4"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"i", "j"}], "TI"], 
     StyleBox["k", "TI"]], "\[LongEqual]", 
    StyleBox[
     RowBox[{"Connection", "[", " ", 
      RowBox[{"[", 
       RowBox[{"i", ",", "j", ",", "k"}], "]"}], " ", "]"}],
     FontSlant->"Plain"], "."}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ffcbad43-54a4-4906-945e-cb32e998a321"],
 "  "
}], "DisplayFormula",ExpressionUUID->"7400ea73-cf43-4936-b040-f4fd4d4af555"],

Cell[TextData[{
 "Recall the Koszul formula ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[Cell[BoxData[
     FormBox[GridBox[{
        {Cell[TextData[{
          " ",
          Cell[BoxData[
           RowBox[{
            StyleBox["g", "TI"], 
            RowBox[{"(", 
             RowBox[{
              SubscriptBox[
               StyleBox["D", "TI"], 
               SubscriptBox[
                StyleBox["m", "TI"], 
                StyleBox["i", "TI"]]], 
              SubscriptBox[
               StyleBox["m", "TI"], 
               StyleBox["j", "TI"]], ",", 
              SubscriptBox[
               StyleBox["m", "TI"], 
               StyleBox["k", "TI"]]}], ")"}], "\[LongEqual]", 
            FractionBox["1", "2"], "("}]], "InlineFormula",ExpressionUUID->
           "b202c71e-53fb-4b43-a395-48b37d267904"],
          " "
         }],ExpressionUUID->"ee8a4a3b-fdb3-48bd-8cdb-d876472e224d"], Cell[
         TextData[{
          " ",
          Cell[BoxData[
           RowBox[{
            SubscriptBox[
             StyleBox["m", "TI"], 
             StyleBox["i", "TI"]], 
            StyleBox["g", "TI"], 
            RowBox[{"(", 
             RowBox[{
              SubscriptBox[
               StyleBox["m", "TI"], 
               StyleBox["j", "TI"]], ",", 
              SubscriptBox[
               StyleBox["m", "TI"], 
               StyleBox["k", "TI"]]}], ")"}], "+", 
            SubscriptBox[
             StyleBox["m", "TI"], 
             StyleBox["j", "TI"]], 
            StyleBox["g", "TI"], 
            RowBox[{"(", 
             RowBox[{
              SubscriptBox[
               StyleBox["m", "TI"], 
               StyleBox["i", "TI"]], ",", 
              SubscriptBox[
               StyleBox["m", "TI"], 
               StyleBox["k", "TI"]]}], ")"}], "-", 
            SubscriptBox[
             StyleBox["m", "TI"], 
             StyleBox["k", "TI"]], 
            StyleBox["g", "TI"], 
