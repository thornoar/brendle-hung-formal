Cell["\<\
rd=P1[L[hd]]//Simplify;
rcd=P1[L[hcd]];
zd=-Inverse[H].rd//Simplify;
A3=4*P0[Q[hcd,hd]]+2*rcd.zd;\
\>", "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"d78fc057-0f5c-4ac9-94ff-db525188df25"],

Cell[TextData[{
 "We restrict ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["A", "TI"], "3"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"2f678c01-2a05-41b8-81ad-d6b609caf05b"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "6afa9e58-3396-483e-8512-5ae928e43fab"],
 " to ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    SubscriptBox["\[CapitalSigma]", "+"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"6a06528e-6e6c-4bbb-88de-0d6cfb4e9f64"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "4890d0da-3f7a-4163-a5ac-fc0dac0d7e88"],
 ", and check that under the above parametrization, we have ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["A", "TI"], "3"], "\[LongEqual]", 
     FractionBox[
      RowBox[{"cos", 
       RowBox[{"(", 
        RowBox[{"2", "\[Theta]"}], ")"}], "cos", 
       RowBox[{"(", 
        RowBox[{"2", "\[Phi]"}], ")"}]}], 
      RowBox[{"3", 
       RowBox[{"(", 
        RowBox[{"7", "-", 
         RowBox[{"cos", 
          RowBox[{"(", 
           RowBox[{"4", "\[Theta]"}], ")"}]}]}], ")"}]}]], "."}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "a5a3df63-f287-4e2e-a150-ca02d5e055a4"],
  "  "
 }], "DisplayFormula",ExpressionUUID->"a720bfa2-1a83-42a3-a56f-06ad5cd9a3bb"]
}], "Text",ExpressionUUID->"f0d371ad-92ca-45dc-9eb4-3084d6a0ec1b"],

Cell[CellGroupData[{

Cell["\<\
pA3=A3/.pTorus//FullSimplify;
pA3Exp=(Cos[2 \[Theta]]*Cos[2 \[Phi]])/(3(7 - Cos[4 \[Theta]]));
(pA3-pA3Exp//Simplify) == 0\
\>", "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"f76e9a8f-47ff-44ad-8b62-146e8038afb1"],

Cell[BoxData["\<\"\"\>"], "Output",
